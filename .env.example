# Copy to .env. Do not commit real credentials.
# Reviewed upstream Hermes image. Keep the digest immutable until an upgrade is reviewed.
HERMES_UPSTREAM_IMAGE=nousresearch/hermes-agent@sha256:0c718ed0e390a9b4d87dc7f1bcc5c6314920d9d380699346d3887c8a1de50e95
HERMES_DATA=./factory-data/hermes
FACTORY_WORKSPACES=./factory-workspaces
HOST_WORKSPACES_ROOT=F:/hermes/factory-workspaces
# Absolute host path containing repositories Hermes may operate on.
PROJECTS_ROOT=F:/projects
HOST_PROJECTS_ROOT=F:/projects
POSTGRES_PASSWORD=change-me
FACTORY_API_KEY=change-me-use-a-long-random-value
# HMAC key for the internal Executor -> Hermes webhook. Generate with:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLowerInvariant()
FACTORY_WEBHOOK_SECRET=change-me-use-a-different-long-random-value
# Upstream Hermes webhook response target. Use log to retain a dashboard
# Sessions entry, or a connected adapter such as telegram, discord, slack, or
# email. CHAT_ID is optional when that adapter has an upstream home channel.
FACTORY_NOTIFICATION_DELIVER=log
FACTORY_NOTIFICATION_CHAT_ID=
CODEX_AUTH_VOLUME=codex-auth
GITHUB_TOKEN=
MAX_WORKERS=3
# Maintenance interlock. Set true only after a fresh run plan is approved for dispatch.
FACTORY_DISPATCH_ENABLED=false
WORKER_MONITOR_SECONDS=5
HERMES_DASHBOARD_PORT=127.0.0.1:9119
